<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window's own colour shows before the first frame (a cold start, or coming back after Android
         stopped the app): the app's paper colour, not the platform's white (overnight review round 10). -->
    <style name="Theme.Collectibles" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:windowSplashScreenBackground">@color/window_background</item>
    </style>
</resources>
